/* Copy this file to secrets.h (same folder) and fill it in.
   NEVER commit the real secrets.h. */

#define WIFI_SSID        "YOUR_WIFI_NAME"
#define WIFI_PASSWORD    "YOUR_WIFI_PASSWORD"

/* The Vercel deployment base URL, no trailing slash. */
#define SERVER_URL       "https://hydrolevel.vercel.app"

/* Values from the Devices page: register the device ONCE and copy the
   API key — it is shown a single time and stored only as a hash. */
#define DEVICE_CODE      "ESP32_XXXX"
#define DEVICE_API_KEY   "wm_paste_the_key_here"

#define FIRMWARE_VERSION "2.0.0"
